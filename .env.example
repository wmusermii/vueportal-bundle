PORT=3000
# Koneksi PostgreSQL. Ganti user, password, host, dan nama database.
DATABASE_URL=postgres://DB_USER:DB_PASSWORD@localhost:5432/DB_NAME
# Schema tempat semua tabel aplikasi berada (huruf kecil, angka, _). Bawaan: portal
DB_SCHEMA=portal
# ========= FOR AUTH LOGIN ATTRB ======== #
# Buat: node -p "require('crypto').randomBytes(48).toString('hex')"
JWT_SECRET=GANTI_DENGAN_HASIL_ACAK
COOKIE_SECURE=false
# ========= FOR PARAMETER SECRET
# Buat: node -p "require('crypto').randomBytes(32).toString('hex')"
PARAM_ENC_KEY=GANTI_DENGAN_HASIL_ACAK

TRUST_PROXY=1
